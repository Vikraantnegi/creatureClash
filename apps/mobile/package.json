{
  "name": "@creature-clash/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@creature-clash/battle-engine": "workspace:*",
    "expo": "~57.0.20",
    "expo-dev-client": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "pnpm --filter @creature-clash/battle-engine build && expo start --dev-client",
    "start:go": "pnpm --filter @creature-clash/battle-engine build && expo start --go",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform ios --platform android --output-dir dist",
    "native:prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true
}
